import asyncio
import re
from playwright import async_api
from playwright.async_api import expect

async def run_test():
    pw = None
    browser = None
    context = None

    try:
        # Start a Playwright session in asynchronous mode
        pw = await async_api.async_playwright().start()

        # Launch a Chromium browser in headless mode with custom arguments
        browser = await pw.chromium.launch(
            headless=True,
            args=[
                "--window-size=1280,720",
                "--disable-dev-shm-usage",
                "--ipc=host",
                "--single-process"
            ],
        )

        # Create a new browser context (like an incognito window)
        context = await browser.new_context()
        # Wider default timeout to match the agent's DOM-stability budget;
        # auto-waiting Playwright APIs (expect, locator.wait_for) inherit this.
        context.set_default_timeout(15000)

        # Open a new page in the browser context
        page = await context.new_page()

        # Interact with the page elements to simulate user flow
        # -> navigate
        await page.goto("http://localhost:8080")
        try:
            await page.wait_for_load_state("domcontentloaded", timeout=5000)
        except Exception:
            pass
        
        # -> Click the 'Create Citizen Account' link to open the registration form.
        # Create Citizen Account arrow_forward link
        elem = page.get_by_role('link', name='Create Citizen Account arrow_forward', exact=True)
        await elem.click(timeout=10000)
        
        # -> Fill the 'Full Name', 'Mobile Number', 'National ID Number', 'Date of Birth', and 'Create Password' fields with valid values.
        # As per NID text field
        elem = page.locator('[id="fullName"]')
        await elem.wait_for(state="visible", timeout=10000)
        await elem.fill("Test Citizen")
        
        # -> Fill the 'Full Name', 'Mobile Number', 'National ID Number', 'Date of Birth', and 'Create Password' fields with valid values.
        # 01XXXXXXXXX text field
        elem = page.locator('[id="phone"]')
        await elem.wait_for(state="visible", timeout=10000)
        await elem.fill("01700000000")
        
        # -> Fill the 'Full Name', 'Mobile Number', 'National ID Number', 'Date of Birth', and 'Create Password' fields with valid values.
        # 10 or 17 digit NID text field
        elem = page.locator('[id="nid"]')
        await elem.wait_for(state="visible", timeout=10000)
        await elem.fill("1234567890")
        
        # -> Fill the 'Full Name', 'Mobile Number', 'National ID Number', 'Date of Birth', and 'Create Password' fields with valid values.
        # dob date field
        elem = page.locator('[id="dob"]')
        await elem.wait_for(state="visible", timeout=10000)
        await elem.fill("1990-01-01")
        
        # -> Fill the 'Full Name', 'Mobile Number', 'National ID Number', 'Date of Birth', and 'Create Password' fields with valid values.
        # password password field
        elem = page.locator('[id="password"]')
        await elem.wait_for(state="visible", timeout=10000)
        await elem.fill("citizen123")
        
        # -> Check the 'I agree to the Terms of Service and Privacy Policy' checkbox, then click the 'Continue to OTP Verification' button.
        # checkbox
        elem = page.locator('xpath=/html/body/div/div[2]/div/form/div[6]/input')
        await elem.click(timeout=10000)
        
        # -> Check the 'I agree to the Terms of Service and Privacy Policy' checkbox, then click the 'Continue to OTP Verification' button.
        # Continue to OTP Verification arrow_forward button
        elem = page.get_by_role('button', name='Continue to OTP Verification arrow_forward', exact=True)
        await elem.click(timeout=10000)
        
        # --> Assertions to verify final state
        
        # --> Verify the OTP verification page is displayed
        # Assert: Expected URL to contain '/otp' indicating the OTP verification page is displayed.
        await expect(page).to_have_url(re.compile("/otp"), timeout=15000), "Expected URL to contain '/otp' indicating the OTP verification page is displayed."
        await asyncio.sleep(5)

    finally:
        if context:
            await context.close()
        if browser:
            await browser.close()
        if pw:
            await pw.stop()

asyncio.run(run_test())
    
